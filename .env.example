# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careflow
DB_USER=postgres
DB_PASSWORD=replace_with_your_database_password

# Groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# n8n
N8N_SHARED_SECRET=replace_with_a_long_random_secret
N8N_WEBHOOK_URL=http://localhost:5678/webhook/careflow

# LangSmith (disabled by default because workflow state may contain patient data)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careflow-ai-dev

# Optional: set this only when using a region outside the default US region.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
